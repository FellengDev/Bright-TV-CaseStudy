{
  "datasets": [
    {
      "name": "f780eabe",
      "displayName": "Total Subscribers",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Total Subscribers\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    COUNT(DISTINCT UserID) AS Total_Subscribers\r\n",
        "FROM retail.default.user_profiles_bright_tv_dataset;"
      ]
    },
    {
      "name": "32e7c556",
      "displayName": "Total Sessions",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Total Sessions\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    COUNT(*) AS Total_Sessions\r\n",
        "FROM retail.default.viewership_bright_tv_dataset;"
      ]
    },
    {
      "name": "a18f7573",
      "displayName": "Active Subscribers",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Active Subscribers\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    COUNT(DISTINCT COALESCE(UserID0, UserID4)) AS Active_Subscribers\r\n",
        "FROM retail.default.viewership_bright_tv_dataset;"
      ]
    },
    {
      "name": "24b66f1a",
      "displayName": "Inactive Subscribers",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Inactive Subscribers\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    COUNT(DISTINCT u.UserID) AS Inactive_Subscribers\r\n",
        "FROM retail.default.user_profiles_bright_tv_dataset u\r\n",
        "LEFT JOIN retail.default.viewership_bright_tv_dataset v\r\n",
        "    ON u.UserID = COALESCE(v.UserID0, v.UserID4)\r\n",
        "WHERE COALESCE(v.UserID0, v.UserID4) IS NULL;"
      ]
    },
    {
      "name": "cfddbf0f",
      "displayName": "Avg Sessions per Subscriber",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Average Sessions per Active Subscriber\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        COUNT(*) * 1.0 /\r\n",
        "        COUNT(DISTINCT COALESCE(UserID0, UserID4)),\r\n",
        "        2\r\n",
        "    ) AS Avg_Sessions_Per_Subscriber\r\n",
        "FROM retail.default.viewership_bright_tv_dataset;"
      ]
    },
    {
      "name": "c4bf27ab",
      "displayName": "Avg Session Duration (min)",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Average Session Duration (Minutes)\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        AVG(\r\n",
        "            HOUR(`Duration 2`) * 60 +\r\n",
        "            MINUTE(`Duration 2`) +\r\n",
        "            SECOND(`Duration 2`) / 60.0\r\n",
        "        ),\r\n",
        "        2\r\n",
        "    ) AS Avg_Session_Duration_Minutes\r\n",
        "FROM retail.default.viewership_bright_tv_dataset;"
      ]
    },
    {
      "name": "03b7bf05",
      "displayName": "Total Watch Time (min)",
      "queryLines": [
        "----------------------------------------------------\r\n",
        "-- KPI: Total Watch Time (Minutes)\r\n",
        "----------------------------------------------------\r\n",
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        SUM(\r\n",
        "            HOUR(`Duration 2`) * 60 +\r\n",
        "            MINUTE(`Duration 2`) +\r\n",
        "            SECOND(`Duration 2`) / 60.0\r\n",
        "        ),\r\n",
        "        2\r\n",
        "    ) AS Total_Watch_Time_Minutes\r\n",
        "FROM retail.default.viewership_bright_tv_dataset;"
      ]
    },
    {
      "name": "30dabaf6",
      "displayName": "Sessions by Day of Week",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "-- Dashboard: Sessions by Day of Week\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    DATE_FORMAT(RecordDate2 + INTERVAL 2 HOURS,'E') AS Day_Name,\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "FROM retail.default.viewership_bright_tv_dataset\r\n",
        "GROUP BY\r\n",
        "    DAYOFWEEK(RecordDate2 + INTERVAL 2 HOURS),\r\n",
        "    DATE_FORMAT(RecordDate2 + INTERVAL 2 HOURS,'E')\r\n",
        "ORDER BY\r\n",
        "    DAYOFWEEK(RecordDate2 + INTERVAL 2 HOURS);"
      ]
    },
    {
      "name": "59a64920",
      "displayName": "Session By Hour of Day",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "-- Dashboard: Sessions by Hour of Day\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    HOUR(RecordDate2 + INTERVAL 2 HOURS) AS Hour_Of_Day,\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "FROM retail.default.viewership_bright_tv_dataset\r\n",
        "GROUP BY\r\n",
        "    HOUR(RecordDate2 + INTERVAL 2 HOURS)\r\n",
        "ORDER BY\r\n",
        "    Hour_Of_Day;"
      ]
    },
    {
      "name": "10dbb1f4",
      "displayName": "Monthly Bright TV Viewership Sessions Summary",
      "queryLines": [
        "\r\n",
        "SELECT\r\n",
        "    DATE_FORMAT(RecordDate2 + INTERVAL 2 HOURS,'yyyyMM') AS Month_ID,\r\n",
        "    MONTHNAME(RecordDate2 + INTERVAL 2 HOURS) AS Month_Name,\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "FROM retail.default.viewership_bright_tv_dataset\r\n",
        "GROUP BY\r\n",
        "    DATE_FORMAT(RecordDate2 + INTERVAL 2 HOURS,'yyyyMM'),\r\n",
        "    MONTHNAME(RecordDate2 + INTERVAL 2 HOURS)\r\n",
        "ORDER BY\r\n",
        "    Month_ID;"
      ]
    },
    {
      "name": "be44898e",
      "displayName": "Top 10 TV Channels",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "-- Dashboard: Top 10 TV Channels\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN LOWER(Channel2) = 'sawsee' THEN 'SawSee'\r\n",
        "        WHEN Channel2 IN\r\n",
        "        (\r\n",
        "            'Supersport Live Events',\r\n",
        "            'SuperSport Live Events',\r\n",
        "            'Live on SuperSport'\r\n",
        "        )\r\n",
        "        THEN 'SuperSport Live Events'\r\n",
        "        ELSE Channel2\r\n",
        "    END AS Tv_Channel,\r\n",
        "\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN LOWER(Channel2) = 'sawsee' THEN 'SawSee'\r\n",
        "        WHEN Channel2 IN\r\n",
        "        (\r\n",
        "            'Supersport Live Events',\r\n",
        "            'SuperSport Live Events',\r\n",
        "            'Live on SuperSport'\r\n",
        "        )\r\n",
        "        THEN 'SuperSport Live Events'\r\n",
        "        ELSE Channel2\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Session_Count DESC\r\n",
        "\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "efed2244",
      "displayName": "Channel Viewing Patterns by Category Summary",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "-- Dashboard: Channel Category Split\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN Channel2 LIKE '%SuperSport%' THEN 'Sports'\r\n",
        "        WHEN Channel2 IN ('Cartoon Network','Boomerang') THEN 'Kids'\r\n",
        "        WHEN Channel2 = 'CNN' THEN 'News'\r\n",
        "        ELSE 'Entertainment'\r\n",
        "    END AS Channel_Category,\r\n",
        "\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN Channel2 LIKE '%SuperSport%' THEN 'Sports'\r\n",
        "        WHEN Channel2 IN ('Cartoon Network','Boomerang') THEN 'Kids'\r\n",
        "        WHEN Channel2 = 'CNN' THEN 'News'\r\n",
        "        ELSE 'Entertainment'\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Session_Count DESC;"
      ]
    },
    {
      "name": "e562bf11",
      "displayName": "Age Group Session Duration Insights",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "--Average Session Duration by Age Group\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN u.Age = 0 THEN 'Unknown'\r\n",
        "        WHEN u.Age BETWEEN 1 AND 12 THEN 'Kids'\r\n",
        "        WHEN u.Age BETWEEN 13 AND 19 THEN 'Teenager'\r\n",
        "        WHEN u.Age BETWEEN 20 AND 35 THEN 'Youth'\r\n",
        "        WHEN u.Age BETWEEN 36 AND 50 THEN 'Adult'\r\n",
        "        WHEN u.Age BETWEEN 51 AND 65 THEN 'Elder'\r\n",
        "        ELSE 'Pensioner'\r\n",
        "    END AS Age_Group,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        AVG(\r\n",
        "            HOUR(v.`Duration 2`) * 60 +\r\n",
        "            MINUTE(v.`Duration 2`) +\r\n",
        "            SECOND(v.`Duration 2`) / 60.0\r\n",
        "        ),\r\n",
        "        2\r\n",
        "    ) AS Avg_Duration_Minutes\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset v\r\n",
        "\r\n",
        "LEFT JOIN retail.default.user_profiles_bright_tv_dataset u\r\n",
        "    ON COALESCE(v.UserID0, v.UserID4) = u.UserID\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN u.Age = 0 THEN 'Unknown'\r\n",
        "        WHEN u.Age BETWEEN 1 AND 12 THEN 'Kids'\r\n",
        "        WHEN u.Age BETWEEN 13 AND 19 THEN 'Teenager'\r\n",
        "        WHEN u.Age BETWEEN 20 AND 35 THEN 'Youth'\r\n",
        "        WHEN u.Age BETWEEN 36 AND 50 THEN 'Adult'\r\n",
        "        WHEN u.Age BETWEEN 51 AND 65 THEN 'Elder'\r\n",
        "        ELSE 'Pensioner'\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Avg_Duration_Minutes DESC;"
      ]
    },
    {
      "name": "ef157efc",
      "displayName": "Gender Session Insights Report",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "--Sessions by Gender\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN u.Gender IS NULL OR TRIM(u.Gender) = '' OR u.Gender = 'None'\r\n",
        "        THEN 'Unknown'\r\n",
        "        ELSE u.Gender\r\n",
        "    END AS Gender,\r\n",
        "\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset v\r\n",
        "\r\n",
        "LEFT JOIN retail.default.user_profiles_bright_tv_dataset u\r\n",
        "    ON COALESCE(v.UserID0, v.UserID4) = u.UserID\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN u.Gender IS NULL OR TRIM(u.Gender) = '' OR u.Gender = 'None'\r\n",
        "        THEN 'Unknown'\r\n",
        "        ELSE u.Gender\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Session_Count DESC;"
      ]
    },
    {
      "name": "20d9fddf",
      "displayName": "Diversity in Viewing Sessions Analysis",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "-- Sessions by Race\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN u.Race IS NULL OR TRIM(u.Race) = '' OR LOWER(u.Race) = 'other'\r\n",
        "        THEN 'Unknown'\r\n",
        "        ELSE u.Race\r\n",
        "    END AS Race,\r\n",
        "\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset v\r\n",
        "\r\n",
        "LEFT JOIN retail.default.user_profiles_bright_tv_dataset u\r\n",
        "    ON COALESCE(v.UserID0, v.UserID4) = u.UserID\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN u.Race IS NULL OR TRIM(u.Race) = '' OR LOWER(u.Race) = 'other'\r\n",
        "        THEN 'Unknown'\r\n",
        "        ELSE u.Race\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Session_Count DESC;"
      ]
    },
    {
      "name": "313f3a76",
      "displayName": "Province-Based Session Overview",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "--  Sessions by Province\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN u.Province IS NULL OR TRIM(u.Province) = '' OR u.Province = 'None'\r\n",
        "        THEN 'Unknown'\r\n",
        "        ELSE u.Province\r\n",
        "    END AS Province,\r\n",
        "\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset v\r\n",
        "\r\n",
        "LEFT JOIN retail.default.user_profiles_bright_tv_dataset u\r\n",
        "    ON COALESCE(v.UserID0, v.UserID4) = u.UserID\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN u.Province IS NULL OR TRIM(u.Province) = '' OR u.Province = 'None'\r\n",
        "        THEN 'Unknown'\r\n",
        "        ELSE u.Province\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Session_Count DESC;"
      ]
    },
    {
      "name": "2a471359",
      "displayName": "Weekday vs Weekend",
      "queryLines": [
        "--------------------------------------------------------\r\n",
        "-- Weekday vs Weekend\r\n",
        "--------------------------------------------------------\r\n",
        "\r\n",
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN DATE_FORMAT(v.RecordDate2 + INTERVAL 2 HOURS, 'E') IN ('Sat', 'Sun')\r\n",
        "        THEN 'Weekend'\r\n",
        "        ELSE 'Weekday'\r\n",
        "    END AS Day_Classification,\r\n",
        "\r\n",
        "    COUNT(*) AS Session_Count\r\n",
        "\r\n",
        "FROM retail.default.viewership_bright_tv_dataset v\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN DATE_FORMAT(v.RecordDate2 + INTERVAL 2 HOURS, 'E') IN ('Sat', 'Sun')\r\n",
        "        THEN 'Weekend'\r\n",
        "        ELSE 'Weekday'\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY Session_Count DESC;"
      ]
    }
  ],
